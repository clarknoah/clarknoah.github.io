{
  "name": "clarknoah-ing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "nx dev web",
    "build": "nx build web",
    "validate": "bun run tools/validate/index.ts",
    "introspect": "bun run tools/arch-introspect/index.ts",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "latest",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "nx": "^20.3.0",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
